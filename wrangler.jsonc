{
  "name": "fluri-grinch",
  "main": "workers/site.ts",
  "account_id": "b1daed2b24d520cf26a5ea50571cb1a3",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "grinch.fluri.xyz",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./site-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
